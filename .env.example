# --- Deutsche Bahn API Marketplace (free registration: developers.deutschebahn.com) ---
# Create an application, subscribe it to the "Timetables" API, then copy both values.
DB_CLIENT_ID=your-client-id
DB_API_KEY=your-api-key

# --- Google BigQuery (free sandbox: console.cloud.google.com -> new project -> BigQuery) ---
GCP_PROJECT_ID=your-project-id
BQ_LOCATION=EU

# Auth option A (local dev, recommended): run `gcloud auth application-default login`
# Auth option B (CI): point this at a service-account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
