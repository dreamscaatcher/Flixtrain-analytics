// DAX measures for the Rail Ops dashboard.
// NOTE: business logic (delay thresholds, load factor, revenue/seat-km) is
// computed in BigQuery rail_ops_marts views -- these measures only aggregate and
// format. Never re-derive KPI logic in DAX: the warehouse is the single
// source of truth.

// ---------- Operations (v_kpi_ops_daily / fact_stop_events) ----------

Punctuality % (6 min) =
AVERAGE ( v_kpi_ops_daily[punctuality_6min] )

Punctuality % (15 min) =
AVERAGE ( v_kpi_ops_daily[punctuality_15min] )

Avg Arrival Delay (min) =
AVERAGE ( v_kpi_ops_daily[avg_arrival_delay_min] )

Cancellation Rate =
AVERAGE ( v_kpi_ops_daily[cancellation_rate] )

Punctuality vs Prev Period =
VAR Current = [Punctuality % (6 min)]
VAR Previous =
    CALCULATE ( [Punctuality % (6 min)], DATEADD ( dim_date[date_key], -7, DAY ) )
RETURN Current - Previous

// ---------- Commercial (v_kpi_route_daily; synthetic overlay) ----------

Total Revenue EUR =
SUM ( v_kpi_route_daily[revenue_eur] )

Total Passengers =
SUM ( v_kpi_route_daily[passengers] )

Avg Load Factor =
AVERAGE ( v_kpi_route_daily[avg_load_factor] )

Revenue per Seat-km =
DIVIDE (
    SUM ( v_kpi_route_daily[revenue_eur] ),
    SUMX (
        v_kpi_route_daily,
        v_kpi_route_daily[revenue_eur] / v_kpi_route_daily[revenue_per_seat_km]
    )
)

Revenue MTD =
TOTALMTD ( [Total Revenue EUR], dim_date[date_key] )

Load Factor 7d Avg =
AVERAGEX (
    DATESINPERIOD ( dim_date[date_key], MAX ( dim_date[date_key] ), -7, DAY ),
    [Avg Load Factor]
)
